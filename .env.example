# Copy this file to .env and replace the placeholder values.
# The real .env file is ignored by Git. Never commit secrets.

# Shared
NODE_ENV=development

# API
API_PORT=3001
APP_NAME=Al9ani API
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# PostgreSQL (local Docker only)
POSTGRES_USER=al9ani
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=al9ani
POSTGRES_PORT=5432
# Host used by Prisma. Leave unset to use 127.0.0.1.
# POSTGRES_HOST=127.0.0.1

# Optional: override the Prisma connection string. When unset, the API and the
# Prisma CLI build it from POSTGRES_* above. Keep real credentials out of Git.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/al9ani?schema=public

# Authentication (use a unique random value of at least 32 characters)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=al9ani_refresh
# Set to true when serving over HTTPS. Required in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_TTL_MS=60000
# Tests only. Leave false in development and production.
AUTH_RATE_LIMIT_DISABLED=false

# Admin provisioning (pass directly to `npm run create-admin`; do not commit)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-random-password
# ADMIN_FIRST_NAME=Al9ani
# ADMIN_LAST_NAME=Admin
