{
  "name": "@al9ani/api",
  "version": "0.1.0",
  "private": true,
  "description": "Al9ani backend API",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" prisma.config.ts",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" prisma.config.ts --fix",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/auth.e2e.test.js dist-test/test/establishments.e2e.test.js",
    "test:watch": "tsc -p tsconfig.test.json && node --test --watch dist-test/test/auth.e2e.test.js dist-test/test/establishments.e2e.test.js",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.19.21",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
