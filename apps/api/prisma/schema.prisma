// Al9ani initial data model.
//
// The datasource URL is supplied by prisma.config.ts so that the CLI and the
// application can derive it from the existing POSTGRES_* environment variables.
// Connection strings are never committed.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum EstablishmentStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum BookingType {
  APPOINTMENT
  CLASS
  RESOURCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  // Argon2id encoded hash. Nullable so existing rows and future external-auth
  // accounts remain valid; accounts created through this API always set it.
  passwordHash String?  @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  phone        String?  @db.VarChar(32)
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  ownedEstablishments Establishment[]  @relation("EstablishmentOwner")
  reservations        Reservation[]
  favorites           Favorite[]
  refreshSessions     RefreshSession[]

  @@index([role])
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  // All rotations of one login share a family. Reuse of a revoked token
  // revokes the whole family to contain stolen refresh tokens.
  familyId            String    @db.Uuid
  // SHA-256 hex of the opaque refresh token. Plaintext is never stored.
  tokenHash           String    @unique @db.Char(64)
  expiresAt           DateTime  @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)
  replacedBySessionId String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Establishment {
  id           String              @id @default(uuid()) @db.Uuid
  ownerId      String              @db.Uuid
  name         String              @db.VarChar(160)
  slug         String              @unique @db.VarChar(180)
  description  String?             @db.Text
  status       EstablishmentStatus @default(DRAFT)
  // Reason recorded when an administrator rejects or suspends an establishment.
  statusReason String?             @db.VarChar(500)
  phone        String?             @db.VarChar(32)
  email        String?             @db.VarChar(320)
  website      String?             @db.VarChar(500)
  addressLine  String?             @db.VarChar(255)
  city         String              @db.VarChar(120)
  governorate  String?             @db.VarChar(120)
  postalCode   String?             @db.VarChar(20)
  country      String              @default("TN") @db.Char(2)
  latitude     Decimal?            @db.Decimal(9, 6)
  longitude    Decimal?            @db.Decimal(9, 6)
  // IANA time zone used to interpret business hours and to present reservation
  // times. All reservation instants are still stored as UTC timestamps.
  timezone     String              @default("Africa/Tunis") @db.VarChar(64)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  owner User @relation("EstablishmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  categories         EstablishmentCategory[]
  services           Service[]
  businessHours      BusinessHours[]
  unavailablePeriods UnavailablePeriod[]
  reservations       Reservation[]
  favorites          Favorite[]
  subscription       Subscription?

  @@index([ownerId])
  @@index([status, city])
  @@index([city])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  establishments EstablishmentCategory[]

  @@index([isActive])
}

model EstablishmentCategory {
  establishmentId String   @db.Uuid
  categoryId      String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([establishmentId, categoryId])
  @@index([categoryId])
}

model Service {
  id              String      @id @default(uuid()) @db.Uuid
  establishmentId String      @db.Uuid
  name            String      @db.VarChar(160)
  description     String?     @db.Text
  // APPOINTMENT: one customer per duration slot.
  // CLASS: several customers share a slot up to capacity.
  // RESOURCE: a court/facility booked exclusively for a time range.
  bookingType     BookingType
  durationMinutes Int
  capacity        Int         @default(1)
  // Decimal, not floating point: TND has three decimal places (millimes).
  price           Decimal     @default(0.000) @db.Decimal(10, 3)
  currency        String      @default("TND") @db.Char(3)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  reservations       Reservation[]
  unavailablePeriods UnavailablePeriod[]

  @@unique([establishmentId, name])
  @@index([establishmentId, isActive])
}

model BusinessHours {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @db.Uuid
  dayOfWeek       DayOfWeek
  // Local wall-clock minutes since midnight. 1440 represents the end of day.
  // Multiple rows per day are allowed for split opening hours.
  opensAtMinute   Int
  closesAtMinute  Int
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, dayOfWeek, opensAtMinute, closesAtMinute])
}

model UnavailablePeriod {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @db.Uuid
  // Null means the whole establishment is unavailable (holiday, closure).
  // A non-null service confines the period to one bookable service.
  serviceId       String?  @db.Uuid
  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  reason          String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([establishmentId, startsAt, endsAt])
  @@index([serviceId, startsAt, endsAt])
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  establishmentId String            @db.Uuid
  serviceId       String            @db.Uuid
  startsAt        DateTime          @db.Timestamptz(3)
  endsAt          DateTime          @db.Timestamptz(3)
  status          ReservationStatus @default(PENDING)
  partySize       Int               @default(1)
  // Price captured when the reservation is created, in the service currency.
  price           Decimal           @default(0.000) @db.Decimal(10, 3)
  currency        String            @default("TND") @db.Char(3)
  notes           String?           @db.Text
  cancelledAt     DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  customer      User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Overlap and capacity checks will run inside a serialisable transaction that
  // locks the service row. These indexes keep those conflict queries fast.
  @@index([customerId, startsAt])
  @@index([establishmentId, startsAt, endsAt])
  @@index([serviceId, startsAt, endsAt])
  @@index([status, startsAt])
}

model Favorite {
  userId          String   @db.Uuid
  establishmentId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([userId, establishmentId])
  @@index([establishmentId])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  establishmentId    String             @unique @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  planName           String             @default("Standard") @db.VarChar(80)
  price              Decimal            @default(69.000) @db.Decimal(10, 3)
  currency           String             @default("TND") @db.Char(3)
  billingInterval    BillingInterval    @default(MONTHLY)
  currentPeriodStart DateTime?          @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}
